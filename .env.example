# Copie para .env (que NÃO vai para o Git) e preencha na VM. Nunca coloque valores reais aqui.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Opcional: modelo preferido. Vai para o início da fila; se falhar, o bot tenta os outros.
# Sem ele, o bot percorre TODOS os modelos de texto que a sua chave enxerga, do mais leve
# ao mais pesado, até um responder (python scripts/testar_gemini.py mostra a ordem).
GEMINI_MODELO=
# Opcional: modelo do Whisper para voz (tiny, base, small, medium). Padrão: base
WHISPER_MODELO=
SUPABASE_URL=
SUPABASE_KEY=
PAINEL_URL=
# Opcional: porta do painel (padrão 8000; o Caddy aponta para ela)
PAINEL_PORTA=
SESSAO_SEGREDO=
DUCKDNS_TOKEN=
