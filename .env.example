# Copie para .env (que NÃO vai para o Git) e preencha na VM. Nunca coloque valores reais aqui.
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Opcional: modelo preferido. Fica em primeiro lugar na cascata; se falhar, o bot tenta os outros.
# Padrão da cascata: gemini-flash-lite-latest, gemini-flash-latest, gemini-2.5-flash-lite, gemini-2.5-flash.
# Deixe vazio para usar o padrão (python scripts/testar_gemini.py mostra o que a sua chave aceita).
GEMINI_MODELO=
SUPABASE_URL=
SUPABASE_KEY=
PAINEL_URL=
SESSAO_SEGREDO=
DUCKDNS_TOKEN=
